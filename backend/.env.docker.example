# Template for backend/.env.docker — copy to `.env.docker` and fill in real
# values. The real file is git-ignored; this example is committed.
#   cp backend/.env.docker.example backend/.env.docker
JWT_SECRET=change-me-generate-a-long-random-hex   # e.g. `openssl rand -hex 32`
JWT_ALGORITHM=HS256
TIMEOUT_MINUTES=30
REFRESH_TIMEOUT_DAYS=7
VERIFICATION_TTL_HOURS=24
RESET_TTL_HOURS=1
# Host is the compose service name `db`; password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://ncplusplus_user:CHANGE_ME@db:5432/ncplusplus_dev
RESEND_API_KEY=re_your_resend_key_here
EMAIL_FROM=noreply@mail.ncplusplus.co.uk
FRONTEND_URL=http://localhost:8080
# Training is ON locally because the compose stack runs a `worker` to drain the
# queue. In prod (App Runner) there is no worker yet, so set this to false there
# until the worker has an always-on home — otherwise POSTs queue jobs nothing runs.
TRAINING_ENABLED=true
