# Single-origin front door: serve the built React app AND reverse-proxy the API.
# ${PORT} and ${BACKEND_URL} are filled in by envsubst at container start.
server {
    listen ${PORT};
    root   /usr/share/nginx/html;
    index  index.html;

    # API: proxy the backend's route prefixes on the SAME origin. No path
    # rewrite, so the /auth-scoped refresh cookie's path still matches. If you
    # add a new top-level router, add its prefix here (or migrate to an /api
    # prefix — see docs/deployment.md §6.6).
    location ~ ^/(auth|users|health|scalar) {
        proxy_pass ${BACKEND_URL};
        # Host defaults to the upstream host from proxy_pass ($proxy_host). We set
        # it explicitly for clarity — it must be the BACKEND's host, because a
        # managed HTTPS upstream (App Runner / Cloud Run) routes by Host, so
        # sending the web host ($host) would 404. Harmless for the local http
        # upstream (FastAPI ignores Host — no TrustedHostMiddleware).
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Send SNI on the upstream TLS handshake. REQUIRED for an https://
        # upstream (App Runner / Cloud Run reject a handshake without it); a
        # no-op for the local http upstream, so it's safe to leave on always.
        proxy_ssl_server_name on;
    }

    # SPA: everything else falls back to index.html for client-side routing.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
