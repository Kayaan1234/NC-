# --- Python ---
__pycache__/
*.pyc
venv/
.venv/
.mypy_cache/

# --- Node / frontend build (frontend/ has its own .gitignore too) ---
node_modules/
dist/
dist-ssr/
*.local

# --- Secrets & local config (never ship) ---
*.env
# real compose secrets (not caught by *.env — ends in .docker, not .env):
.env.docker
*.db

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
**/.DS_Store

# --- Markdown / planning docs (not shipped to production) ---
*.md

# --- Python test cache ---
.pytest_cache/

# --- Logs ---
*.log

# --- Deployment source configs (embed secret ARNs + account details) ---
apprunner-*.json

# --- Personal Claude Code settings (local permissions) ---
.claude/settings.local.json