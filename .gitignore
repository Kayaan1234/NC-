# --- Python ---
__pycache__/
*.pyc
venv/
.venv/
.mypy_cache/

# --- Node / frontend build (frontend/ has its own .gitignore too) ---
node_modules/
dist/
dist-ssr/
*.local

# --- Secrets & local config (never ship) ---
# Every real dotenv variant: .env, foo.env, .env.local, .env.production,
# .env.docker, … The *.example templates are re-included just below so the
# committed placeholders (.env.example, backend/.env.docker.example, …) survive.
*.env
.env
.env.*
!*.example
*.db

# --- Keys, certs, cloud credentials (defensive — none tracked today) ---
*.pem
*.key
*.pfx
*.p12
id_rsa*
.aws/
*-service-account*.json

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
**/.DS_Store

# --- Markdown / planning docs (not shipped to production) ---
*.md

# --- Python test cache ---
.pytest_cache/

# --- Logs ---
*.log

# --- Deployment source configs (embed secret ARNs + account details) ---
apprunner-*.json

# --- Personal Claude Code settings (local permissions) ---
.claude/settings.local.json

# --- Local scripts (nat-up/down, etc.) — but keep the tracked Docker entrypoint ---
*.sh
!docker/backend-entrypoint.sh