# Keep build contexts small and secrets OUT of images. Applies to the whole
# repo-root context (both Dockerfiles build from here).
**/venv
**/.venv
**/node_modules
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/dist
**/.env
**/.env.*
.git
.gitignore
# Compiled training binaries are platform-specific (the committed one is macOS).
# The image compiles its own Linux build in a dedicated stage, so keep the host
# binary out of the context entirely.
backend/services/**/nn
